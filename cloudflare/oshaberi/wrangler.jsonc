{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"oshaberi", "main":"src/index.js",
 "compatibility_date":"2026-10-01", "compatibility_flags":["nodejs_compat"],
 "workers_dev":false, "preview_urls":false,
 "assets":{"directory":"public","binding":"ASSETS","run_worker_first":true},
 "vars":{"RELEASE_ENABLED":"0","REGISTRATION_ENABLED":"0","INVITATIONS_ENABLED":"0"},
 "d1_databases":[{"binding":"CHAT_DB","database_name":"oshaberi-local-only","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"CHAT_FILES","bucket_name":"oshaberi-local-only"}]
 // No routes, cron, HOME services, production IDs or deployment workflow.
}
