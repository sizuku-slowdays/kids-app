{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "asobu.cetus.fun", "custom_domain": true },
    { "pattern": "cetus.fun/wagaya/*", "zone_name": "cetus.fun" },
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-db",
      "database_id": "fed5c0be-51b5-486f-935f-58678481f2a9",
      "migrations_dir": "migrations",
    },
    {
      "binding": "LEGACY_DB",
      "database_name": "mama-bank-db",
      "database_id": "17c4957a-fb76-44f9-a909-3f343049aeb3",
    },
  ],
  "r2_buckets": [{ "binding": "PRIVATE_FILES", "bucket_name": "home-private" }],
  "services": [
    { "binding": "CALENDAR_SERVICE", "service": "calendar-worker" },
    { "binding": "LEGACY_BANK_SERVICE", "service": "mama-bank-api" },
    { "binding": "LEGACY_CHORE_SERVICE", "service": "otetsudai-api" },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["15 18 * * *", "0 15 * * *"] },
}
