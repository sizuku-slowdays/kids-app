{
  "name": "oshaberi-private-development",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "esbuild src/qr-entry.js --bundle --format=esm --minify --outfile=public/qr.js && wrangler deploy --dry-run --outdir .build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "jpeg-js": "0.4.4",
    "miniflare": "5.20260930.0-alpha",
    "pngjs": "7.0.0",
    "wrangler": "4.145.0"
  }
}
