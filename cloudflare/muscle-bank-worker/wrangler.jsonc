{
  "name": "muscle-bank-worker",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "vars": {"ALLOWED_ORIGIN": "https://cetus.fun"},
  "services": [{"binding":"HOME_AUTH", "service":"home-worker"}],
  "d1_databases": [{"binding":"DB", "database_name":"muscle-bank-db", "database_id":"REPLACE_WITH_NEW_D1_ID", "migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"PHOTOS", "bucket_name":"muscle-bank-private"}]
}
